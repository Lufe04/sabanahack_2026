{
  "name": "sabanahack_2026",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:up": "docker compose up -d",
    "db:push": "dotenv -e .env.local -- drizzle-kit push",
    "db:seed": "dotenv -e .env.local -- tsx scripts/seed.ts",
    "db:reset": "npm run db:push && npm run db:seed",
    "db:studio": "dotenv -e .env.local -- drizzle-kit studio",
    "sim:calibrar": "tsx scripts/calibrar.ts",
    "typecheck": "tsc --noEmit",
    "db:timezone": "dotenv -e .env.local -- tsx scripts/timezone.ts",
    "db:push:prod": "dotenv -e .env.production.local -- drizzle-kit push --force",
    "db:seed:prod": "dotenv -e .env.production.local -- tsx scripts/seed.ts",
    "db:setup:prod": "npm run db:push:prod && npm run db:seed:prod",
    "deploy": "vercel deploy --prod"
  },
  "dependencies": {
    "@vercel/functions": "^3.10.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.10.1",
    "shadcn": "^4.22.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20"
  }
}
