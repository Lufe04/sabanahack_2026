# Postgres local (docker compose up -d). En Vercel las inyecta la integración de Neon:
# DATABASE_URL (pooler, para la app) y DATABASE_URL_UNPOOLED (directa, para migraciones y seed).
DATABASE_URL=postgresql://arandanos:arandanos@localhost:5433/arandanos
# Token para proteger la API de ingesta y el cron del simulador
INGEST_API_KEY=cambia-este-token
CRON_SECRET=cambia-este-secreto
# Clave entre servidores para GET /api/events. Nunca en el navegador ni con prefijo NEXT_PUBLIC_
DASHBOARD_READ_API_KEY=cambia-esta-clave
